@model ManageEventViewModel
@{
    ViewData["Title"] = "Manage Event";
}

<section class="mb-10 flex flex-col gap-6 rounded-[2rem] bg-surface-container-low p-8 md:flex-row md:items-end md:justify-between">
    <div>
        <div class="flex items-center gap-3">
            <span class="rounded-full bg-secondary-container px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-on-secondary-container">@Model.Event.Status</span>
            <span class="text-sm font-semibold text-on-surface-variant">Last edited @Model.Event.UpdatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</span>
        </div>
        <h1 class="mt-4 text-5xl font-black tracking-tight">@Model.Event.Title</h1>
        <p class="mt-4 max-w-3xl text-on-surface-variant">@Model.Event.Description</p>
    </div>
    <div class="text-right">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-on-surface-variant">Event timeline</p>
        <p class="mt-2 text-2xl font-bold text-primary">@Model.Event.DateRangeText</p>
    </div>
</section>

<div class="grid gap-6 lg:grid-cols-12">
    <section class="rounded-[1.75rem] bg-surface-container-lowest p-8 shadow-sm lg:col-span-8">
        <h2 class="mb-6 text-2xl font-bold">Quick actions</h2>
        <div class="grid gap-4 md:grid-cols-3">
            <a asp-action="Create" class="rounded-[1.5rem] bg-surface-container-low p-6 transition hover:-translate-y-1 hover:shadow-lg">
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-fixed text-primary">
                    <span class="material-symbols-outlined">content_copy</span>
                </div>
                <h3 class="text-lg font-bold">Create another event</h3>
                <p class="mt-2 text-sm text-on-surface-variant">Spin up a fresh draft with the same backend flow.</p>
            </a>
            <a asp-action="Schedule" asp-route-id="@Model.Event.Id" class="rounded-[1.5rem] bg-surface-container-low p-6 transition hover:-translate-y-1 hover:shadow-lg">
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-fixed text-primary">
                    <span class="material-symbols-outlined">calendar_today</span>
                </div>
                <h3 class="text-lg font-bold">Edit schedule</h3>
                <p class="mt-2 text-sm text-on-surface-variant">Add agenda sessions and update timing.</p>
            </a>
            <a asp-action="Media" asp-route-id="@Model.Event.Id" class="rounded-[1.5rem] bg-surface-container-low p-6 transition hover:-translate-y-1 hover:shadow-lg">
                <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-fixed text-primary">
                    <span class="material-symbols-outlined">perm_media</span>
                </div>
                <h3 class="text-lg font-bold">Manage media</h3>
                <p class="mt-2 text-sm text-on-surface-variant">Upload covers, clips, and folder structures.</p>
            </a>
        </div>
    </section>

    <aside class="rounded-[1.75rem] bg-primary p-8 text-white shadow-[0_24px_64px_-24px_rgba(53,37,205,0.45)] lg:col-span-4">
        <h2 class="text-xl font-bold">Performance summary</h2>
        <div class="mt-8 space-y-6">
            <div>
                <p class="text-sm font-medium text-on-primary-container">Total attendees</p>
                <p class="mt-1 text-4xl font-black">@Model.Event.Registrations.Count</p>
            </div>
            <div>
                <p class="text-sm font-medium text-on-primary-container">Tickets sold</p>
                <p class="mt-1 text-4xl font-black">@Model.Event.TicketsSoldPercentage%</p>
                <div class="mt-3 h-2 overflow-hidden rounded-full bg-white/20">
                    <div class="h-full rounded-full bg-white" style="width: @Model.Event.TicketsSoldPercentage%;"></div>
                </div>
            </div>
            <div>
                <p class="text-sm font-medium text-on-primary-container">Revenue</p>
                <p class="mt-1 text-4xl font-black">$@Model.Event.Revenue.ToString("N0")</p>
            </div>
        </div>
    </aside>

    <section class="rounded-[1.75rem] bg-surface-container-lowest p-8 shadow-sm lg:col-span-6">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-bold">Recent activity</h2>
            <span class="text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">@Model.Event.RecentActivities.Count items</span>
        </div>
        <div class="space-y-4">
            @foreach (var activity in Model.Event.RecentActivities.Take(5))
            {
                <article class="flex items-start gap-4 rounded-2xl bg-surface-container-low p-4">
                    <div class="flex h-11 w-11 items-center justify-center rounded-full bg-primary-fixed text-primary">
                        <span class="material-symbols-outlined">@activity.Icon</span>
                    </div>
                    <div class="flex-1">
                        <p class="font-bold">@activity.Title</p>
                        <p class="mt-1 text-sm text-on-surface-variant">@activity.Description</p>
                    </div>
                    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-on-surface-variant">@activity.RelativeTime</span>
                </article>
            }
        </div>
    </section>

    <section class="rounded-[1.75rem] bg-surface-container-lowest p-8 shadow-sm lg:col-span-6">
        <div class="mb-6 flex items-center justify-between">
            <h2 class="text-2xl font-bold">Upcoming deadlines</h2>
            <span class="rounded-full bg-tertiary-fixed px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-tertiary">@Model.Event.Deadlines.Count items</span>
        </div>
        <div class="space-y-4">
            @foreach (var deadline in Model.Event.Deadlines)
            {
                <article class="rounded-2xl bg-surface-container-low p-4">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <p class="font-bold">@deadline.Title</p>
                            <p class="mt-1 text-sm @(deadline.IsCritical ? "text-error" : "text-on-surface-variant")">@deadline.DueText</p>
                        </div>
                        <span class="rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] @(deadline.IsCritical ? "bg-error-container text-on-error-container" : "bg-surface-container-highest text-on-surface-variant")">
                            @(deadline.IsCritical ? "Critical" : "Planned")
                        </span>
                    </div>
                </article>
            }
        </div>
        <div class="mt-8 flex flex-wrap gap-3">
            <a asp-action="Assets" asp-route-id="@Model.Event.Id" class="rounded-full bg-surface-container-high px-4 py-2.5 text-sm font-bold text-on-surface transition hover:bg-surface-dim">Open asset library</a>
            <a asp-controller="Events" asp-action="Details" asp-route-id="@Model.Event.Id" class="rounded-full bg-primary px-4 py-2.5 text-sm font-bold text-white transition hover:bg-primary-container">Preview attendee page</a>
        </div>
    </section>
</div>
