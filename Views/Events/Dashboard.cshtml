@model UserDashboardViewModel
@{
    ViewData["Title"] = "My Events";
}

<section class="mb-10 flex flex-col gap-6 rounded-[2rem] bg-surface-container-low p-8 md:flex-row md:items-end md:justify-between">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Attendee dashboard</p>
        <h1 class="mt-3 text-5xl font-black tracking-tight">Curator view for participants</h1>
        <p class="mt-4 max-w-2xl text-on-surface-variant">
            Registered events, upcoming sessions, and recommended experiences all live behind the same ASP.NET Core routes.
        </p>
    </div>
    <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
        <div class="rounded-2xl bg-surface-container-lowest p-4 text-center">
            <div class="text-3xl font-black text-primary">@Model.RegisteredEvents.Count</div>
            <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">Registered</div>
        </div>
        <div class="rounded-2xl bg-surface-container-lowest p-4 text-center">
            <div class="text-3xl font-black text-primary">@Model.RegisteredEvents.Sum(item => item.Sessions.Count)</div>
            <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">Sessions</div>
        </div>
        <div class="rounded-2xl bg-surface-container-lowest p-4 text-center">
            <div class="text-3xl font-black text-primary">@Model.RecommendedEvents.Count</div>
            <div class="mt-1 text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">Recommended</div>
        </div>
    </div>
</section>

<div class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr]">
    <section>
        <div class="mb-6 flex items-center justify-between gap-4">
            <div>
                <h2 class="text-2xl font-black tracking-tight">Registered events</h2>
                <p class="mt-1 text-sm text-on-surface-variant">These are the events tied to your signed-in email.</p>
            </div>
            <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-primary transition hover:text-primary-container">Explore more</a>
        </div>

        @if (Model.RegisteredEvents.Count == 0)
        {
            <div class="rounded-[1.5rem] bg-surface-container-lowest p-8 shadow-sm">
                <h3 class="text-xl font-bold">No registrations yet</h3>
                <p class="mt-3 max-w-xl text-on-surface-variant">Open one of the event detail pages below, submit the registration form, and this dashboard will update immediately.</p>
            </div>
        }
        else
        {
            <div class="space-y-5">
                @foreach (var eventItem in Model.RegisteredEvents)
                {
                    <article class="overflow-hidden rounded-[1.5rem] bg-surface-container-lowest shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
                        <div class="grid gap-6 md:grid-cols-[0.38fr_0.62fr]">
                            <img src="@eventItem.CoverImageUrl" alt="@eventItem.Title" class="h-full min-h-56 w-full object-cover" />
                            <div class="flex flex-col justify-between p-6">
                                <div>
                                    <div class="flex items-center justify-between gap-4">
                                        <span class="rounded-full bg-primary-fixed px-3 py-1 text-xs font-bold uppercase tracking-[0.18em] text-on-primary-fixed-variant">@eventItem.Category</span>
                                        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">@eventItem.Status</span>
                                    </div>
                                    <h3 class="mt-4 text-2xl font-bold tracking-tight">@eventItem.Title</h3>
                                    <p class="mt-3 text-sm leading-7 text-on-surface-variant">@eventItem.Summary</p>
                                    <div class="mt-4 grid gap-3 text-sm text-on-surface-variant">
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-primary">calendar_today</span>
                                            <span>@eventItem.DateRangeText</span>
                                        </div>
                                        <div class="flex items-center gap-3">
                                            <span class="material-symbols-outlined text-primary">location_on</span>
                                            <span>@eventItem.Location</span>
                                        </div>
                                    </div>
                                </div>
                                <div class="mt-6 flex items-center justify-between gap-4">
                                    <span class="text-sm font-semibold text-on-surface-variant">@eventItem.Sessions.Count scheduled sessions</span>
                                    <a asp-action="Details" asp-route-id="@eventItem.Id" class="rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white transition hover:bg-primary-container">View itinerary</a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <aside class="space-y-6">
        <div class="rounded-[1.75rem] bg-primary p-7 text-white shadow-[0_24px_64px_-24px_rgba(53,37,205,0.45)]">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-on-primary-container">Need organizer access?</p>
            <h2 class="mt-3 text-2xl font-bold">Switch to the management side</h2>
            <p class="mt-3 text-sm leading-7 text-on-primary-container">Log in with an organizer-style email and the create, schedule, media, and dashboard screens become available.</p>
            <a asp-controller="Auth" asp-action="Login" class="mt-6 inline-flex rounded-full bg-white px-5 py-2.5 text-sm font-bold text-primary transition hover:bg-slate-50">Change account</a>
        </div>

        <div class="rounded-[1.75rem] bg-surface-container-lowest p-7 shadow-sm">
            <div class="mb-5 flex items-center justify-between gap-4">
                <h2 class="text-xl font-bold">Recommended next</h2>
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-on-surface-variant">@Model.RecommendedEvents.Count events</span>
            </div>
            <div class="space-y-4">
                @foreach (var eventItem in Model.RecommendedEvents)
                {
                    <a asp-action="Details" asp-route-id="@eventItem.Id" class="block rounded-2xl bg-surface-container-low p-4 transition hover:bg-surface-container-high">
                        <p class="text-xs font-bold uppercase tracking-[0.18em] text-primary">@eventItem.Category</p>
                        <h3 class="mt-2 text-lg font-bold tracking-tight">@eventItem.Title</h3>
                        <p class="mt-2 text-sm text-on-surface-variant">@eventItem.DateRangeText</p>
                    </a>
                }
            </div>
        </div>
    </aside>
</div>
