@model AdminEditUserPageViewModel
@{
    ViewData["Title"] = "Edit User";
}

<section class="mb-10">
    <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Super admin</p>
    <h1 class="mt-3 text-5xl font-black tracking-tight">Edit account</h1>
    <p class="mt-4 max-w-3xl text-lg leading-8 text-on-surface-variant">Adjust identity details, roles, and account state without leaving the admin workspace.</p>
</section>

<div class="grid gap-8 lg:grid-cols-[0.62fr_0.38fr]">
    <div class="space-y-8">
        <form id="edit-user-form" asp-action="EditUser" asp-route-id="@Model.Form.Id" method="post" class="rounded-[1.75rem] bg-surface-container-lowest p-8 shadow-sm">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="mt-6 grid gap-5 md:grid-cols-2">
                <input asp-for="Form.Id" type="hidden" />
                <div class="md:col-span-2">
                    <label asp-for="Form.DisplayName" class="mb-2 block text-sm font-semibold"></label>
                    <input asp-for="Form.DisplayName" class="w-full rounded-2xl border-0 bg-surface-container-low px-4 py-3.5 focus:ring-2 focus:ring-primary-container" />
                    <span asp-validation-for="Form.DisplayName"></span>
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Form.Email" class="mb-2 block text-sm font-semibold"></label>
                    <input asp-for="Form.Email" class="w-full rounded-2xl border-0 bg-surface-container-low px-4 py-3.5 focus:ring-2 focus:ring-primary-container" />
                    <span asp-validation-for="Form.Email"></span>
                </div>
                <label class="md:col-span-2 flex items-center gap-3 rounded-2xl bg-surface-container-low px-4 py-3.5 text-sm font-semibold">
                    <input asp-for="Form.IsActive" class="h-4 w-4 rounded text-primary focus:ring-primary" />
                    Keep account active
                </label>
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
                <button type="submit" class="rounded-full bg-primary px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-container">Save changes</button>
                <a asp-action="Users" class="rounded-full bg-surface-container-high px-5 py-3 text-sm font-bold text-on-surface transition hover:bg-surface-dim">Back to users</a>
            </div>
        </form>

        <form asp-action="ResetPassword" asp-route-id="@Model.PasswordResetForm.Id" method="post" class="rounded-[1.75rem] bg-surface-container-lowest p-8 shadow-sm">
            <h2 class="text-2xl font-bold">Admin password reset</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-2">
                <input asp-for="PasswordResetForm.Id" type="hidden" />
                <div>
                    <label asp-for="PasswordResetForm.Password" class="mb-2 block text-sm font-semibold"></label>
                    <input asp-for="PasswordResetForm.Password" class="w-full rounded-2xl border-0 bg-surface-container-low px-4 py-3.5 focus:ring-2 focus:ring-primary-container" />
                    <span asp-validation-for="PasswordResetForm.Password"></span>
                </div>
                <div>
                    <label asp-for="PasswordResetForm.ConfirmPassword" class="mb-2 block text-sm font-semibold"></label>
                    <input asp-for="PasswordResetForm.ConfirmPassword" class="w-full rounded-2xl border-0 bg-surface-container-low px-4 py-3.5 focus:ring-2 focus:ring-primary-container" />
                    <span asp-validation-for="PasswordResetForm.ConfirmPassword"></span>
                </div>
            </div>
            <button type="submit" class="mt-6 rounded-full bg-primary px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-container">Reset password</button>
        </form>
    </div>

    <aside class="space-y-8">
        <div class="rounded-[1.75rem] bg-primary p-7 text-white shadow-[0_24px_64px_-24px_rgba(53,37,205,0.45)]">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-on-primary-container">Roles</p>
            <div class="mt-6 space-y-3">
                @for (var index = 0; index < Model.RoleOptions.Count; index++)
                {
                    <label class="flex items-center gap-3 rounded-2xl bg-white/10 px-4 py-3.5 text-sm font-semibold">
                        <input type="checkbox" name="Form.Roles" value="@Model.RoleOptions[index].Name" form="edit-user-form" checked="@Model.RoleOptions[index].IsSelected" class="h-4 w-4 rounded text-white focus:ring-white" />
                        @Model.RoleOptions[index].Name
                    </label>
                }
            </div>
            @if (Model.IsSelf)
            {
                <p class="mt-4 text-sm text-on-primary-container">Your own super admin access cannot be removed from this screen.</p>
            }
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
