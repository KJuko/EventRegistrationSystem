@model AdminUsersPageViewModel
@{
    ViewData["Title"] = "Admin Users";
}

<section class="mb-10 grid gap-8 lg:grid-cols-[1fr_0.34fr]">
    <div class="rounded-[2rem] bg-surface-container-low p-8">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Super admin</p>
        <h1 class="mt-3 text-5xl font-black tracking-tight">User management</h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-on-surface-variant">Create accounts, assign roles, lock down access, and reset credentials from one production-grade Identity workspace.</p>
        <form method="get" class="mt-8 flex flex-col gap-4 sm:flex-row">
            <input name="q" value="@Model.Query" class="flex-1 rounded-full border-0 bg-surface-container-lowest px-5 py-3.5 focus:ring-2 focus:ring-primary-container" placeholder="Search by name or email" />
            <button type="submit" class="rounded-full bg-primary px-5 py-3 text-sm font-bold text-white transition hover:bg-primary-container">Search</button>
        </form>
    </div>
    <div class="rounded-[1.75rem] bg-primary p-7 text-white shadow-[0_24px_64px_-24px_rgba(53,37,205,0.45)]">
        <p class="text-xs font-bold uppercase tracking-[0.22em] text-on-primary-container">Directory</p>
        <div class="mt-4 text-5xl font-black">@Model.Users.Count</div>
        <p class="mt-2 text-sm text-on-primary-container">accounts currently available</p>
        <a asp-action="CreateUser" class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-bold text-primary transition hover:bg-surface-container-low">Create user</a>
    </div>
</section>

<section class="rounded-[1.75rem] bg-surface-container-lowest p-7 shadow-sm">
    <div class="mb-6 flex items-center justify-between gap-4">
        <h2 class="text-2xl font-bold">Accounts</h2>
        <a asp-action="CreateUser" class="text-sm font-semibold text-primary transition hover:text-primary-container">New account</a>
    </div>
    <div class="grid gap-6 xl:grid-cols-2">
        @foreach (var user in Model.Users)
        {
            <article class="rounded-[1.5rem] bg-surface-container-low p-6">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <h3 class="text-xl font-bold">@user.DisplayName</h3>
                        <p class="mt-1 text-sm text-on-surface-variant">@user.Email</p>
                    </div>
                    <span class="rounded-full @(user.IsActive ? "bg-primary text-white" : "bg-error-container text-on-error-container") px-3 py-1 text-xs font-bold uppercase tracking-[0.16em]">@(user.IsActive ? "Active" : "Inactive")</span>
                </div>
                <div class="mt-5 flex flex-wrap gap-2">
                    @foreach (var role in user.Roles)
                    {
                        <span class="rounded-full bg-surface-container-high px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-on-surface-variant">@role</span>
                    }
                    @if (user.IsLockedOut)
                    {
                        <span class="rounded-full bg-error-container px-3 py-1 text-xs font-bold uppercase tracking-[0.16em] text-on-error-container">Locked</span>
                    }
                </div>
                <div class="mt-5 text-sm text-on-surface-variant">Created @user.CreatedAtUtc.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a asp-action="EditUser" asp-route-id="@user.Id" class="rounded-full bg-primary px-4 py-2.5 text-sm font-bold text-white transition hover:bg-primary-container">Edit</a>
                    @if (user.IsLockedOut)
                    {
                        <form asp-action="UnlockUser" asp-route-id="@user.Id" method="post">
                            <button type="submit" class="rounded-full bg-surface-container-high px-4 py-2.5 text-sm font-bold text-on-surface transition hover:bg-surface-dim">Unlock</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="LockUser" asp-route-id="@user.Id" method="post">
                            <button type="submit" class="rounded-full bg-surface-container-high px-4 py-2.5 text-sm font-bold text-on-surface transition hover:bg-surface-dim">Lock</button>
                        </form>
                    }
                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post">
                        <button type="submit" class="rounded-full bg-error-container px-4 py-2.5 text-sm font-bold text-on-error-container transition hover:brightness-95">Delete</button>
                    </form>
                </div>
            </article>
        }
    </div>
</section>
