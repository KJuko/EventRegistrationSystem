@model PasswordResetConfirmationViewModel
@{
    ViewData["Title"] = "Check Your Email";
}

<div class="mx-auto max-w-2xl py-12">
    <div class="rounded-[2rem] bg-surface-container-lowest p-10 text-center shadow-[0_24px_60px_-24px_rgba(53,37,205,0.16)]">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-primary-fixed text-on-primary-fixed-variant">
            <span class="material-symbols-outlined text-4xl">mark_email_read</span>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Confirmation</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight">Reset link prepared</h1>
        <p class="mt-4 text-lg leading-8 text-on-surface-variant">
            If an active account exists for <span class="font-semibold text-on-surface">@Model.Email</span>, reset instructions have been prepared.
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.ResetLink))
        {
            <div class="mt-6 rounded-2xl bg-surface-container-low p-5 text-left text-sm text-on-surface-variant">
                <p class="font-semibold text-on-surface">Development reset link</p>
                <p class="mt-2 break-all">
                    <a href="@Model.ResetLink" class="font-semibold text-primary transition hover:text-primary-container">@Model.ResetLink</a>
                </p>
            </div>
        }
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a asp-action="Login" class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-white transition hover:bg-primary-container">Back to login</a>
            <a asp-controller="Home" asp-action="Index" class="rounded-full bg-surface-container-low px-6 py-3 text-sm font-bold text-on-surface transition hover:bg-surface-container-high">Return home</a>
        </div>
    </div>
</div>
