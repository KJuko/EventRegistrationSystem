@model PasswordResetInput
@{
    ViewData["Title"] = "Password Reset";
}

<div class="mx-auto max-w-lg py-8">
    <div class="rounded-[2rem] bg-surface-container-lowest p-8 shadow-[0_24px_60px_-24px_rgba(53,37,205,0.16)] md:p-10">
        <div class="mb-8">
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Account recovery</p>
            <h1 class="mt-3 text-4xl font-black tracking-tight">Reset your password</h1>
            <p class="mt-3 text-on-surface-variant">Enter the email tied to your account and the backend will route you to a confirmation step.</p>
        </div>
        <form asp-action="PasswordReset" method="post" class="space-y-6">
            <div asp-validation-summary="ModelOnly"></div>
            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-semibold text-on-surface"></label>
                <input asp-for="Email" class="w-full rounded-2xl border-0 bg-surface-container-low px-4 py-3.5 text-on-surface focus:ring-2 focus:ring-primary-container" placeholder="name@company.com" />
                <span asp-validation-for="Email"></span>
            </div>
            <button type="submit" class="w-full rounded-2xl bg-primary px-6 py-4 text-base font-bold text-white shadow-lg shadow-primary/10 transition hover:bg-primary-container">Send reset instructions</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
