@{
    ViewData["Title"] = "Access Denied";
}

<div class="mx-auto max-w-2xl py-12">
    <div class="rounded-[2rem] bg-surface-container-lowest p-10 text-center shadow-[0_24px_60px_-24px_rgba(53,37,205,0.16)]">
        <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-error-container text-on-error-container">
            <span class="material-symbols-outlined text-4xl">lock</span>
        </div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-primary">Authorization</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight">Access denied</h1>
        <p class="mt-4 text-lg leading-8 text-on-surface-variant">
            Your account is signed in, but it does not have permission to open this area.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
            <a asp-controller="Home" asp-action="Index" class="rounded-full bg-primary px-6 py-3 text-sm font-bold text-white transition hover:bg-primary-container">Return home</a>
            <a asp-controller="Events" asp-action="Dashboard" class="rounded-full bg-surface-container-low px-6 py-3 text-sm font-bold text-on-surface transition hover:bg-surface-container-high">Open my events</a>
        </div>
    </div>
</div>
